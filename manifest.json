{
  "manifest_version": 3,
  "name": "IRoar Premium",
  "version": "2.2.1",
  "description": "Search Clemson iROAR services and classes, compare grade history and instructor ratings, and preview your weekly schedule.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.ratemyprofessors.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.sis.clemson.edu/*"
      ],
      "css": [
        "banner-restyler.css"
      ],
      "js": [
        "navigation.js",
        "banner-restyler.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://regssb.sis.clemson.edu/StudentRegistrationSsb/ssb/classSearch/classSearch*"
      ],
      "css": [
        "registration.css"
      ],
      "js": [
        "schedule.js",
        "registration.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://sadv.sis.clemson.edu/StudentSelfService/ssb/studentCommonDashboard*"
      ],
      "js": [
        "dashboard.js"
      ],
      "css": [
        "dashboard.css"
      ]
    },
    {
      "matches": [
        "https://iroar.app.clemson.edu/dashboard/*"
      ],
      "css": [
        "portal.css"
      ],
      "js": [
        "portal.js"
      ]
    },
    {
      "matches": [
        "https://regssb.sis.clemson.edu/StudentRegistrationSsb/ssb/plan/*",
        "https://regssb.sis.clemson.edu/StudentRegistrationSsb/ssb/classRegistration/*",
        "https://regssb.sis.clemson.edu/StudentRegistrationSsb/ssb/classSearch/classSearch*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ]
}
